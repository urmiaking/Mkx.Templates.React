{
    "$schema":  "http://json.schemastore.org/template",
    "author":  "Mkx",
    "name":  "Mkx React + ASP.NET Core Solution",
    "identity":  "Mkx.Templates.React",
    "shortName":  "mkx-react",
    "classifications":  [
                            "Web",
                            "React",
                            "TypeScript",
                            "ASP.NET Core",
                            "Clean Architecture"
                        ],
    "tags":  {
                 "language":  "C#",
                 "type":  "solution"
             },
    "sourceName":  "Mkx.Templates",
    "preferNameDirectory":  false,
    "sources":  [
                    {
                        "source":  "./",
                        "target":  "./",
                        "exclude":  [
                                        "**/[Bb]in/**",
                                        "**/[Oo]bj/**",
                                        "**/node_modules/**",
                                        "**/dist/**",
                                        "**/TestResults/**",
                                        "**/coverage/**",
                                        "**/.git/**",
                                        "**/.vs/**",
                                        "**/*.user",
                                        "**/*.pfx",
                                        "**/*.log",
                                        "**/*.tsbuildinfo",
                                        "**/.env",
                                        "**/.env.*",
                                        "**/appsettings.Push.local.json"
                                    ]
                    },
                    {
                        "source":  "./",
                        "target":  "./",
                        "include":  [
                                        ".env.example"
                                    ],
                        "exclude":  [

                                    ]
                    }
                ]
}
